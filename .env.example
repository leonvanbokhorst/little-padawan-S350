# .env.example — Little Wan Control Tower

# Copy this file to .env (git ignored) and fill in the blanks.
# When sourcing via scripts/load_env.sh be mindful that JSON values lose quotes;
# prefer exporting those directly in your shell (`export KEY='{"foo":"bar"}'`).


# --- Control Tower core ---------------------------------------------------

# Required: WebSocket bridge address that Control Tower will connect to.
# Example: ws://localhost:3000
CONTROL_TOWER_BRIDGE_URL=ws://localhost:3000

# Optional auth token for the bridge (leave blank if not used).
CONTROL_TOWER_BRIDGE_TOKEN=

# Operating mode for Control Tower logic: cloud | local
CONTROL_TOWER_MODE=cloud

# Where to stash persistent artifacts (models, telemetry, etc.).
CONTROL_TOWER_DATA_DIR=.control_tower


# --- Device & vision ------------------------------------------------------

# Serial of the target S350 (or leave empty to operate without a bound device).
CONTROL_TOWER_DEVICE_SERIAL=

# RTSP URL for the S350 video stream. Leave empty to disable the vision loop.
# Example: rtsp://$S350_RTSP_USER:$S350_RTSP_PASS@$S350_IP/live0
CONTROL_TOWER_RTSP_URL=

# Host-side audio source: host | bridge
CONTROL_TOWER_AUDIO_SOURCE=host

# Voice activity detection threshold (float). Leave default unless tuning.
CONTROL_TOWER_AUDIO_VAD_THRESHOLD=0.015

# Convenience pieces for fetching RTSP creds from your `.env` in scripts.
S350_RTSP_USER=
S350_RTSP_PASS=
S350_IP=


# --- Providers ------------------------------------------------------------

# LLM provider selection & options JSON.
CONTROL_TOWER_LLM_KIND=openai
CONTROL_TOWER_LLM_OPTIONS=

# Speech-to-text provider and options. Default uses local faster-whisper.
CONTROL_TOWER_STT_KIND=faster-whisper
CONTROL_TOWER_STT_OPTIONS=

# Text-to-speech provider and options.
CONTROL_TOWER_TTS_KIND=openai-tts
CONTROL_TOWER_TTS_OPTIONS=


# --- Logging & diagnostics ------------------------------------------------

# true | false (case-insensitive) to emit JSON logs instead of human-readable.
CONTROL_TOWER_LOG_JSON=false

# Log level: DEBUG | INFO | WARNING | ERROR
CONTROL_TOWER_LOG_LEVEL=INFO

# Health check endpoint queried by control_tower/checks.py
CONTROL_TOWER_STATUS_URL=http://127.0.0.1:9000/status


# --- Eufy bridge credentials ----------------------------------------------

# Only needed when running the bridge that talks to the Eufy security cloud.
EUFY_EMAIL=
EUFY_PASSWORD=
EUFY_SERIAL=
EUFY_COUNTRY=
# Optional overrides for automation helper (defaults applied if left blank).
EUFY_TRUSTED_DEVICE_NAME=LittleWansMech
EUFY_PERSISTENT_DIR=./.eufy-data
